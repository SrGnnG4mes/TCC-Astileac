						"pm.test('Um único e-mail principal', () => pm.expect(principaisEmail).to.have.lengthOf(1));",
						"const principaisTelefone = contatos.filter(c => c.tipo === 'TELEFONE' && c.principal);",
						"pm.test('E o telefone principal não foi afetado', () => pm.expect(principaisTelefone).to.have.lengthOf(1));"
					] } }],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/profissionais/{{profissionalId}}/contatos", "host": ["{{baseUrl}}"], "path": ["profissionais", "{{profissionalId}}", "contatos"] }
					}
				}
			]
		},
