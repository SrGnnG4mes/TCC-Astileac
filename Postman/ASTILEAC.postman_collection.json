						"pm.test('200', () => pm.response.to.have.status(200));",
						"const contatos = pm.response.json();",
						"const emailAntigo = contatos.find(c => c.id === Number(pm.collectionVariables.get('contatoEmailId')));",
						"pm.test('O e-mail principal anterior foi desmarcado', () => pm.expect(emailAntigo.principal).to.be.false);",
