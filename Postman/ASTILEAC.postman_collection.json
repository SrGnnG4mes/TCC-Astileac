						"body": { "mode": "raw", "raw": "{\n  \"nome\": \"Maria Silva\",\n  \"cpf\": \"{{cpfValido}}\",\n  \"dataNascimento\": \"1990-05-10\",\n  \"dataAssociacao\": \"2024-01-15\"\n}" },
						"url": { "raw": "{{baseUrl}}/profissionais", "host": ["{{baseUrl}}"], "path": ["profissionais"] }
