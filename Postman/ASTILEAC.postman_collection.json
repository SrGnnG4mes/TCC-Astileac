						"url": { "raw": "{{baseUrl}}/profissionais/{{profissionalId}}/dados-pessoais/registro-de-acesso", "host": ["{{baseUrl}}"], "path": ["profissionais", "{{profissionalId}}", "dados-pessoais", "registro-de-acesso"] }
					}
				}
			]
		},
		{
			"name": "8. Limpeza",
			"description": "Remove o que a demonstração criou, para a coleção poder ser rodada de novo.",
			"item": [
				{
					"name": "Remover Maria",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('409 — protegido pela chave estrangeira', () => pm.response.to.have.status(409));",
						"pm.test('Explica que há dados vinculados', () => {",
						"    pm.expect(pm.response.json().mensagem).to.include('vinculados');",
						"});",
						"// Não é erro 500: é conflito de estado. Apagar o profissional",
						"// destruiria formações e certificados, que comprovam",
						"// habilitação legal. Para sair de verdade, o caminho é o",
						"// pedido de eliminação do RF10, que apaga tudo junto depois",
						"// dos 30 dias."
					] } }],
					"request": {
						"method": "DELETE",
						"header": [{ "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
						"url": { "raw": "{{baseUrl}}/profissionais/{{profissionalId}}", "host": ["{{baseUrl}}"], "path": ["profissionais", "{{profissionalId}}"] }
					}
				},
				{
					"name": "Remover João (sem dados vinculados além da área)",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('409 ou 204', () => pm.expect([204, 409]).to.include(pm.response.code));"
					] } }],
					"request": {
						"method": "DELETE",
						"header": [{ "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
						"url": { "raw": "{{baseUrl}}/profissionais/{{outroProfissionalId}}", "host": ["{{baseUrl}}"], "path": ["profissionais", "{{outroProfissionalId}}"] }
					}
				},
				{
					"name": "Logout",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('200', () => pm.response.to.have.status(200));"
					] } }],
					"request": {
						"method": "POST",
						"header": [{ "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
						"url": { "raw": "{{baseUrl}}/autenticacao/logout", "host": ["{{baseUrl}}"], "path": ["autenticacao", "logout"] }
					}
				},
				{
					"name": "Depois do logout, protegido de novo → 401",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('401 — a sessão foi realmente encerrada', () => pm.response.to.have.status(401));",
						"// Logout com sessão invalida no servidor. Com JWT, seria",
						"// preciso uma lista de revogação para conseguir o mesmo."
					] } }],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/profissionais", "host": ["{{baseUrl}}"], "path": ["profissionais"] }
					}
				}
			]
		}
	]
