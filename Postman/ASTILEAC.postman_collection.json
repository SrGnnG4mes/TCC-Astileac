{
	"info": {
		"name": "ASTILEAC — API (TCC)",
		"description": "Coleção de demonstração da API do sistema ASTILEAC.\n\nAs requisições estão na ordem dos requisitos funcionais e encadeiam entre si: rode com o Collection Runner, de cima para baixo, e cada pasta aproveita o que a anterior criou.\n\nANTES DE RODAR:\n1. Suba o backend: `cd backend && ./mvnw spring-boot:run`\n2. Preencha as variáveis `login` e `senha` da coleção com a conta administrativa criada pelo bootstrap (as mesmas de app.admin.* no application-local.properties).\n\nSOBRE O CSRF: a API usa sessão com cookie, protegida contra CSRF. A primeira requisição busca o token e o guarda numa variável; as requisições de escrita o enviam no cabeçalho X-XSRF-TOKEN. O cookie de sessão o próprio Postman gerencia.\n\nAs asserções não conferem só o status: verificam as decisões de projeto (CPF mascarado na listagem, erro que não vaza CPF, associado que não alcança cadastro alheio, prazo de 30 dias na exclusão).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Roda ANTES de cada requisição da coleção.",
					"//",
					"// Se a requisição escreve, busca o token CSRF do momento. O",
					"// Spring rotaciona o token ao autenticar, então um token",
					"// guardado antes do login deixa de valer — e dependia da ordem",
					"// de execução para ser renovado. Aqui a renovação acontece",
					"// sempre, então funciona igual rodando a coleção inteira ou",
					"// clicando numa requisição isolada.",
					"//",
					"// GET não precisa: CSRF só protege operações que alteram estado.",
					"if (pm.request.method !== 'GET') {",
					"    pm.sendRequest({",
					"        url: pm.collectionVariables.get('baseUrl') + '/autenticacao/csrf',",
					"        method: 'GET'",
					"    }, function (erro, resposta) {",
					"        if (!erro && resposta.code === 200) {",
					"            pm.collectionVariables.set('csrfToken', resposta.json().token);",
					"        }",
					"    });",
					"}"
				]
			}
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "login", "value": "" },
		{ "key": "senha", "value": "" },
		{ "key": "csrfToken", "value": "" },
		{ "key": "profissionalId", "value": "" },
		{ "key": "outroProfissionalId", "value": "" },
		{ "key": "formacaoId", "value": "" },
		{ "key": "contatoEmailId", "value": "" },
		{ "key": "cpfValido", "value": "11144477735" },
		{ "key": "outroCpfValido", "value": "52998224725" }
	],
	"item": [
		{
			"name": "0. Sessão (RF09)",
			"item": [
				{
					"name": "Obter token CSRF",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('200', () => pm.response.to.have.status(200));",
						"const corpo = pm.response.json();",
						"pm.collectionVariables.set('csrfToken', corpo.token);",
						"pm.test('Token entregue e cookie escrito', () => {",
						"    pm.expect(corpo.token).to.be.a('string').and.not.empty;",
						"    pm.expect(corpo.headerName).to.eql('X-XSRF-TOKEN');",
						"});",
						"// Sem este endpoint a SPA nunca receberia o cookie CSRF e o",
						"// próprio login seria bloqueado por falta de token."
					] } }],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/autenticacao/csrf", "host": ["{{baseUrl}}"], "path": ["autenticacao", "csrf"] }
					}
				},
				{
					"name": "Rota protegida SEM login → 401",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('401 sem autenticação', () => pm.response.to.have.status(401));",
						"pm.test('Responde JSON, não página de login', () => {",
						"    pm.expect(pm.response.json().mensagem).to.include('Autenticacao');",
						"});"
					] } }],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/profissionais", "host": ["{{baseUrl}}"], "path": ["profissionais"] }
					}
				},
				{
					"name": "Login com senha errada → 401",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('401', () => pm.response.to.have.status(401));",
						"pm.test('Não revela se o login existe', () => {",
						"    pm.expect(pm.response.json().mensagem).to.eql('Credenciais invalidas');",
						"});"
					] } }],
					"request": {
						"method": "POST",
						"header": [{ "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
						"body": { "mode": "urlencoded", "urlencoded": [
							{ "key": "login", "value": "{{login}}" },
							{ "key": "senha", "value": "senha-propositalmente-errada" }
						] },
						"url": { "raw": "{{baseUrl}}/autenticacao/login", "host": ["{{baseUrl}}"], "path": ["autenticacao", "login"] }
					}
				},
				{
					"name": "Login",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('200 — sessão estabelecida', () => pm.response.to.have.status(200));",
						"",
						"// O Spring Security ROTACIONA o token CSRF no login, como",
						"// proteção contra fixação de sessão. O token obtido antes",
						"// de entrar fica obsoleto, e a primeira escrita depois dele",
						"// receberia 403. Aqui recapturamos o token novo do cookie.",
						"const tokenNovo = pm.cookies.get('XSRF-TOKEN');",
						"if (tokenNovo) { pm.collectionVariables.set('csrfToken', tokenNovo); }",
						"pm.test('Token CSRF renovado apos o login', () => {",
						"    pm.expect(pm.collectionVariables.get('csrfToken')).to.not.be.empty;",
						"});",
						"if (pm.response.code !== 200) {",
						"    console.log('Preencha as variáveis login e senha da coleção com a conta do bootstrap.');",
						"}"
					] } }],
					"request": {
						"method": "POST",
						"header": [{ "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
						"body": { "mode": "urlencoded", "urlencoded": [
							{ "key": "login", "value": "{{login}}" },
							{ "key": "senha", "value": "{{senha}}" }
						] },
						"url": { "raw": "{{baseUrl}}/autenticacao/login", "host": ["{{baseUrl}}"], "path": ["autenticacao", "login"] }
					}
				},
				{
					"name": "Renovar token CSRF (depois do login)",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('200', () => pm.response.to.have.status(200));",
						"pm.collectionVariables.set('csrfToken', pm.response.json().token);",
						"pm.test('Token renovado', () => {",
						"    pm.expect(pm.collectionVariables.get('csrfToken')).to.not.be.empty;",
						"});",
						"// O Spring Security ROTACIONA o token CSRF ao autenticar, como",
						"// proteção contra fixação de sessão: o token obtido antes de",
						"// entrar deixa de valer. Buscar de novo aqui é mais confiável",
						"// do que ler o cookie por script — pm.cookies nem sempre",
						"// enxerga o cookie, e quando falha a primeira escrita depois",
						"// do login recebe 403."
					] } }],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/autenticacao/csrf", "host": ["{{baseUrl}}"], "path": ["autenticacao", "csrf"] }
					}
				},
				{
					"name": "Quem sou eu",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('200', () => pm.response.to.have.status(200));",
						"const eu = pm.response.json();",
						"pm.test('Perfil ADMIN', () => pm.expect(eu.perfil).to.eql('ADMIN'));",
						"pm.test('Não devolve dado sensível', () => {",
						"    pm.expect(eu).to.not.have.property('senha');",
						"    pm.expect(eu).to.not.have.property('cpf');",
						"});"
					] } }],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/autenticacao/eu", "host": ["{{baseUrl}}"], "path": ["autenticacao", "eu"] }
					}
				}
			]
		},
		{
			"name": "1. Profissional (RF01)",
			"item": [
