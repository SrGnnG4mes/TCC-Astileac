						"// Achar alguém numa lista não exige o CPF inteiro de todos."
					] } }],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/profissionais", "host": ["{{baseUrl}}"], "path": ["profissionais"] }
					}
				}
			]
		},
		{
