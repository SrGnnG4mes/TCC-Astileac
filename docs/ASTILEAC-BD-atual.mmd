erDiagram
	%% DER do sistema atual: 11 tabelas, migrations V1 a V8.
	%% Modelo logico com os tipos do PostgreSQL (o fisico e o SQL das migrations).
	%% Linha cheia = relacionamento identificador: a chave da filha contem a
	%% do pai. So acontece em PROFISSIONAL_AREA, cuja PK e composta.
	%% Linha tracejada = nao identificador: a filha tem id proprio e so
	%% referencia o pai por chave estrangeira.
	%% LOG_ACESSO fica sem ligacao de proposito: registro_id nao e chave
	%% estrangeira, para o registro sobreviver a eliminacao do dado (V4).
	direction TB
	PROFISSIONAL {
		bigint id PK
		varchar(150) nome
		varchar(11) cpf UK
		date data_nascimento
		date data_associacao
		boolean ativo "desativar, nunca apagar"
		varchar(255) lattes_url "opcional (V8)"
		timestamp data_exclusao_solicitada "opcional: pedido do titular (V4)"
	}

	ENDERECO {
		bigint id PK
		bigint profissional_id FK,UK
		varchar(8) cep
		varchar(150) logradouro
		varchar(20) numero
		varchar(100) complemento "opcional"
		varchar(100) bairro
		varchar(100) cidade
		char(2) uf
	}

	CONTATO {
		bigint id PK
		bigint profissional_id FK
		varchar(20) tipo "EMAIL ou TELEFONE"
		varchar(150) valor
		boolean principal "um principal por tipo"
	}

	AREA_ATUACAO {
		bigint id PK
		varchar(50) nome UK
		varchar(255) descricao "opcional"
	}

	PROFISSIONAL_AREA {
		bigint profissional_id PK,FK
		bigint area_atuacao_id PK,FK
		date data_inicio
	}

	FORMACAO {
		bigint id PK
		bigint profissional_id FK
		varchar(50) nivel
		varchar(150) curso
		varchar(150) instituicao
		integer ano_conclusao
	}

	CERTIFICADO {
		bigint id PK
		bigint profissional_id FK
		bigint formacao_id FK "opcional"
		varchar(150) titulo
		varchar(150) instituicao_emissora
		integer carga_horaria
		date data_emissao
		varchar(255) arquivo_path "opcional (V5): só o caminho do PDF"
		timestamp validado_em "opcional: visto da diretoria (V7)"
		varchar(100) validado_por "quem deu o visto (V7)"
	}

	VINCULO_EMPREGATICIO {
		bigint id PK
		bigint profissional_id FK
		varchar(150) instituicao
		varchar(100) cargo
		varchar(50) tipo_vinculo
		date data_inicio
		date data_fim "nula = em andamento"
		boolean atual "derivado de data_fim"
	}

	USUARIO {
		bigint id PK
		bigint profissional_id FK,UK "nulo na conta de instalação"
		varchar(100) login UK
		varchar(255) senha_hash "BCrypt"
		varchar(30) perfil "ADMIN ou PROFISSIONAL"
	}

	CONVITE {
		bigint id PK
		varchar(150) email
		char(64) token_hash UK "SHA-256 do token (V6)"
		timestamp data_emissao
		timestamp data_expiracao "emissão + 7 dias"
		timestamp data_consumo "nula = ainda não utilizado"
		bigint profissional_id FK,UK "preenchido no cadastro"
		varchar(100) emitido_por "login de quem emitiu"
	}

	LOG_ACESSO {
		bigint id PK
		timestamp data_hora
		varchar(100) autor "login, ou nao-autenticado"
		varchar(45) origem "IP, opcional"
		varchar(20) acao "CONSULTA, CRIACAO, ALTERACAO..."
		varchar(50) entidade
		bigint registro_id "sem FK, de propósito (V4)"
		varchar(255) detalhe "opcional"
	}

	%% Identificacao e acesso ficam acima de PROFISSIONAL (relacao escrita da
	%% filha para o pai); o registro profissional fica abaixo. So muda a
	%% posicao no desenho: as cardinalidades sao as mesmas.
	ENDERECO |o..|| PROFISSIONAL : "é endereço de"
	CONTATO }o..|| PROFISSIONAL : "é contato de"
	USUARIO |o..o| PROFISSIONAL : "dá acesso a"
	CONVITE |o..o| PROFISSIONAL : "originou"
	PROFISSIONAL ||--o{ PROFISSIONAL_AREA : "atua em"
	AREA_ATUACAO ||--o{ PROFISSIONAL_AREA : "classifica"
	PROFISSIONAL ||..o{ FORMACAO : "concluiu"
	PROFISSIONAL ||..o{ CERTIFICADO : "declara"
	FORMACAO |o..o{ CERTIFICADO : "é comprovada por"
	PROFISSIONAL ||..o{ VINCULO_EMPREGATICIO : "mantém"
